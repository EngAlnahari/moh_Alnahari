                            {
                                if (Model[i].BorderType == type)
                                {
                                    <option value="@type" selected>@type</option>
                                }
                                else
                                {
                                    <option value="@type">@type</option>
                                }
                            }
                        </select>
                    </td>

                    <!-- الحد كما في الوثيقة -->
                    <td>
                        <input type="text" class="form-control" name="borders[@i].BorderDescription" value="@Model[i].BorderDescription" />
                    </td>

                    <!-- مطابق / غير مطابق -->
                    <td class="text-center">
                        <input type="hidden" name="borders[@i].IdenticalOrDifferent" value="0" />
                        <input type="checkbox" name="borders[@i].IdenticalOrDifferent" value="1" @(Model[i].IdenticalOrDifferent == 1 ? "checked" : "") />
                    </td>

                    <!-- الفرق -->
                    <td>
                        <input type="text" class="form-control" name="borders[@i].Difference" value="@Model[i].Difference" />
                    </td>

                    <!-- UserID -->
                    <input type="hidden" name="borders[@i].UserID" value="@Model[i].UserID" />

                    <td>
                        <button type="button" class="btn btn-danger btn-sm remove-border">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-outline-primary mb-3" id="addBorderRow">
        إضافة حد جديد
    </button>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-danger">@TempData["msg"]</div>
    }

    <div>
        <button type="submit" class="btn btn-success">حفظ</button>
        <a asp-action="Index" class="btn btn-secondary">رجوع</a>
    </div>
</form>

@section Scripts {
    <script>
        let rowIndex = @Model.Count;

        document.getElementById("addBorderRow").addEventListener("click", function(){
            let tbody = document.querySelector("#earthBordersTable tbody");
            let templateRow = tbody.rows[0].cloneNode(true);

            templateRow.querySelectorAll("input, select").forEach(el=>{
                if(el.name){
                    el.name = el.name.replace(/\[\d+\]/, `[${rowIndex}]`);
                }
                if(el.tagName=="SELECT") el.selectedIndex = 0;
                if(el.type=="text") el.value="";
                if(el.type=="checkbox") el.checked=false;
                if(el.type=="hidden" && el.name.includes("UserID")) el.value=2;
            });

            templateRow.cells[0].innerText = rowIndex+1;
            tbody.appendChild(templateRow);
            rowIndex++;
        });

        document.addEventListener("click", function(e){
            if(e.target.closest(".remove-border")){
                e.target.closest("tr").remove();
            }
        });
    </script>
}

