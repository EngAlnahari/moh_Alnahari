@model TransportModelWithDetails
@{
    Layout = null;
    ViewData["Title"] = "Create Work Offer";
}

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th style="width: 40px">#</th>
                <th>المحافظة</th>
                <th>رسوم التنقل</th>
                <th>أجر المبيت</th>
                <th>أجر النثريات</th>
                <th style="width: 50px">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTableRow()">
                        <i class="bi bi-plus"></i>
                    </button>
                </th>
            </tr>
        </thead>
        <tbody id="templateTableBody">
            <tr>
                <td>1</td>
                <td>
                    <select asp-for="transportModels[0].Governorate" class="form-select form-select-sm">

                        <option value="كل المحافضات">كل المحافظة</option>

                    </select>
                </td>
                <input type="hidden" asp-for="transportModels[1].StatuseType1" class="type-status-1" />
                <input type="hidden" asp-for="transportModels[1].StatuseType2" class="type-status-2" />

                <td>
                    <input asp-for="transportModels[1].TransportationFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <input asp-for="transportModels[1].OverNightFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <input asp-for="transportModels[1].AllowanceFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeTableRow(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>

        </tbody>
    </table>

    @*   <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button type="submit" class="btn btn-primary">حفظ القالب</button>
    </div> *@
    @Html.Partial("~/Views/Service/alert_sms.cshtml");
</div>