@model TransportModelWithDetails
@{
    Layout = null;
    ViewData["Title"] = "Create Work Offer";
}
<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th style="width: 40px">#</th>
                <th>المحافظة</th>
                <th>رسوم التنقل</th>
                <th>أجر المبيت</th>
                <th>أجر النثريات</th>
                <th style="width: 50px">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTableRow()">
                        <i class="bi bi-plus"></i>
                    </button>
                </th>
            </tr>
        </thead>
        <tbody id="templateTableBody">
            <tr>
                <td>1</td>
                <td>
                    <select asp-for="transportModels[2].Governorate" class="form-select form-select-sm">


                        <option value="بقية المحافضلت بسعر">  جميع المحافضات </option>

                    </select>
                </td>
                <input type="hidden" asp-for="transportModels[2].StatuseType1" class="type-status-1" />
                <input type="hidden" asp-for="transportModels[2].StatuseType2" class="type-status-2" />

                <td>
                    <input asp-for="transportModels[2].TransportationFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <input asp-for="transportModels[2].OverNightFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <input asp-for="transportModels[2].AllowanceFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeTableRow(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
            <tr>
                <td>1</td>
                <td>
                    <select asp-for="transportModels[3].Governorate" class="form-select form-select-sm">

                        <option value=""> المحافضات المستثناة</option>
                        <option value="صنعاء">صنعاء</option>
                        <option value="تعز">تعز</option>
                        <option value="عدن">عدن</option>
                        <option value="عدن"> عمران</option>
                        <option value="اب">اب </option>

                    </select>
                </td>
                <td>
                    <input asp-for="transportModels[3].TransportationFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <input type="hidden" asp-for="transportModels[3].StatuseType1" class="type-status-1" />
                <input type="hidden" asp-for="transportModels[3].StatuseType2" class="type-status-2" />
                <td>
                    <input asp-for="transportModels[3].OverNightFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <input asp-for="transportModels[3].AllowanceFees" type="number" class="form-control form-control-sm" placeholder="0.00">
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeTableRow(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>


        </tbody>
    </table>


</div>
<br />
<script>
    let rowIndex = 1; // عشان يبدأ بعد الموجود

    function addTableRow() {
        const tableBody = document.getElementById("templateTableBody");

        // أنشئ صف جديد
        const newRow = document.createElement("tr");

        newRow.innerHTML = `
            <td>${rowIndex + 1}</td>
            <td>
                <select name="transportModels[${rowIndex}].Governorate" class="form-select form-select-sm">
                    <option value="">-- اختر محافظة --</option>
                    <option value="صنعاء">صنعاء</option>
                    <option value="تعز">تعز</option>
                    <option value="عدن">عدن</option>
                    <option value="عمران">عمران</option>
                    <option value="اب">إب</option>
                </select>
            </td>
            <td>
                <input name="transportModels[${rowIndex}].TransportationFees" type="number" class="form-control form-control-sm" placeholder="0.00">
            </td>
            <td>
                <input name="transportModels[${rowIndex}].OverNightFees" type="number" class="form-control form-control-sm" placeholder="0.00">
            </td>
            <td>
                <input name="transportModels[${rowIndex}].AllowanceFees" type="number" class="form-control form-control-sm" placeholder="0.00">
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeTableRow(this)">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        tableBody.appendChild(newRow);
        rowIndex++;
    }

    function removeTableRow(button) {
        const row = button.closest("tr");
        row.remove();
    }
</script>
