@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById("conditionSelect").addEventListener("change", function () {
            var rangeFields = document.getElementById("rangeFields");
            if (this.value === "range") {
                rangeFields.style.display = "flex"; // يظهر الصف
            } else {
                rangeFields.style.display = "none"; // يخفيه
            }
        });
    </script>
}
