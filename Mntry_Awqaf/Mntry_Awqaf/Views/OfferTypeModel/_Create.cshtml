@* @await Html.PartialAsync("WorkWagesTaple/Create.cshtml") *@

<div id="additionalContent2" class="mt-3"></div>

<script>
    function loadContent(selectId, targetId) {
        var select = document.getElementById(selectId);
        var targetDiv = document.getElementById(targetId);

        select.addEventListener('change', function() {
            var value = this.value;

            if (value === "3") {
                // الخيار الثالث: استدعاء الصفحة الأولى
                fetch('/TransportModel/Create1')
                    .then(response => response.text())
                    .then(html => targetDiv.innerHTML = html)
                    .catch(err => targetDiv.innerHTML = '<p>حدث خطأ أثناء تحميل الصفحة.</p>');
            }
            else if (value === "4") {
                // الخيار الرابع: استدعاء الصفحة الثانية
                fetch('/TransportModel/Create2')
                    .then(response => response.text())
                    .then(html => targetDiv.innerHTML = html)
                    .catch(err => targetDiv.innerHTML = '<p>حدث خطأ أثناء تحميل الصفحة.</p>');
            }
            else if (value === "2") {
                // الخيار الرابع: استدعاء الصفحة الثانية
                fetch('/TransportModel/Create3')
                    .then(response => response.text())
                    .then(html => targetDiv.innerHTML = html)
                    .catch(err => targetDiv.innerHTML = '<p>حدث خطأ أثناء تحميل الصفحة.</p>');
            }
            else {
                // خيارات أخرى: تنظيف القسم
                targetDiv.innerHTML = '';
            }
        });
    }

    // تفعيل الوظيفة على القسمين
    loadContent('extraChargesSelect1', 'additionalContent1');
    loadContent('extraChargesSelect2', 'additionalContent2');
</script>

<script>
    // نستخدم jQuery لأن البارتشل يضاف بعد تحميل الصفحة
    $(document).on("change", "#IsAllTypesIncluded", function () {
        if ($(this).is(":checked")) {
            $("#table1").hide();
            $("#table2").show();
        } else {
            $("#table1").show();
            $("#table2").hide();
        }
    });
</script>

<!-- ضع هذا div خارج select -->
<div class="collapse mt-3" id="extraTypeModeContainer">
    <div class="card card-body"></div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var select = document.getElementById("transportTemplateSelect11");

        if (select) {
            select.addEventListener("change", function () {
                if (this.value === "create-new") {
                    fetch('/SpecificSpaceTemplate/Create')
                        .then(res => res.text())
                        .then(html => {
                            document.querySelector("#extraTypeModeContainer .card-body").innerHTML = html;

                            var collapse = new bootstrap.Collapse(
                                document.getElementById("extraTypeModeContainer"),
                                { toggle: true }
                            );
                        });
                } else {
                    var collapse = bootstrap.Collapse.getInstance(document.getElementById("extraTypeModeContainer"));
                    if (collapse) collapse.hide();
                }
            });
        }
    });


</script>

