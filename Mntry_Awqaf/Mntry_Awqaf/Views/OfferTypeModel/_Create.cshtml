 @model Mntry_Awqaf.Models.WorkOfferWithDetailsViewModel

@{
    Layout = null;
    ViewData["Title"] = "Create Work ممممممممممممممممممممم";
}

<form asp-action="Create" method="post">
    <div class="modal-body">
        <div class="row mb-3">
            <!-- اسم القالب -->
            <div class="col-md-4">
                <label asp-for="OfferType.WorkWagesName" class="form-label">اسم القالب</label>
                <input asp-for="OfferType.WorkWagesName" type="text" class="form-control" placeholder="أدخل اسم القالب">
            </div>

            <!-- نوع العمل -->
            <div class="col-md-4">
                <label asp-for="OfferType.WorkWagesType" class="form-label">Work Wages Type</label>
                <select asp-for="OfferType.WorkWagesType" class="form-select">
                    <option value="">اختر النوع</option>
                    <option value="piece">مقطوعة</option>
                    <option value="daily">يومية</option>
                    <option value="area">بالإنجاز (حسب المساحة)</option>
                </select>
            </div>

            <!-- شامل لكل الأنواع -->
            <div class="col-md-4 d-flex align-items-center">
                <div class="form-check mt-4">
                    <input name="OfferType.EachTypeSimilar" type="checkbox" class="form-check-input" id="IsAllTypesIncluded">
                    <label asp-for="OfferType.EachTypeSimilar" class="form-check-label ms-2">شامل لكل الأنواع</label>
                </div>
            </div>
        </div>

        <!-- استدعاء الجدول WorkWagesTaple -->
        @await Html.PartialAsync("~/Views/WorkWagesTaple/Create.cshtml")


    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button type="submit" class="btn btn-primary">hhhhhh1111حفظ القالبس</button>
    </div>
</form>
 
 
