@model User

<div class="modal fade" id="userDetailsModal" tabindex="-1" aria-labelledby="userDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title" id="userDetailsModalLabel">
                    طلب المهندس @Model.Frist_Name @Model.Second_Name
                </h5>
            </div>

            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6>📄 السيرة الذاتية:</h6>
                        @if (!string.IsNullOrEmpty(Model.Cv))
                        {
                            <a href="@Model.Cv" target="_blank" class="btn btn-outline-primary btn-sm">عرض السيرة الذاتية</a>
                        }
                        else
                        {
                            <p class="text-muted">لم يتم رفع السيرة الذاتية</p>
                        }
                    </div>

                    <div class="col-md-6">
                        <h6>🎓 صورة المؤهل:</h6>
                        @if (!string.IsNullOrEmpty(Model.Img))
                        {
                            <img src="@Model.Img" alt="صورة المؤهل" class="img-fluid rounded shadow" style="max-height:200px;" />
                        }
                        else
                        {
                            <p class="text-muted">لم يتم رفع صورة المؤهل</p>
                        }
                    </div>
                </div>

                <hr />

                <form id="approveForm" class="text-center">
                    <input type="hidden" name="engineerId" id="engineerId" value="" />
                    <input type="hidden" id="Is_Authentic" name="Is_Authentic" value="" />

                    <button type="button" class="btn btn-success me-2 approve-btn" data-status="1">موافقة</button>
                    <button type="button" class="btn btn-info me-2 approve-btn" data-status="2">توثيق</button>
                    <button type="button" class="btn btn-danger approve-btn" data-status="3">رفض</button>
                </form>

                <div id="alertMessage" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>
