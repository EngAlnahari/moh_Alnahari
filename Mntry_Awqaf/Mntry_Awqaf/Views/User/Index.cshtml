@model IEnumerable<Mntry_Awqaf.Models.User>
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@* @using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
 *@

<div class="tab-pane" id="request" role="tabpanel" aria-labelledby="request-tab">
    <div class="card">
        <div class="card-header">
            <div class="row align-items-center g-2">
                <div class="col">
                    <h5>المستخدمين</h5>
                   
                </div>
                @{
                    var rop = Context.Session.GetInt32("UserID");
                }
                <li class="nav-item">
                    <a class="nav-link">مرحباً مستخدم رقم: @rop</a>
                </li>

               

                <div dir="rtl">


                    <div class="tab-pane" id="to_me" role="tabpanel" aria-labelledby="request-tab">
                        <div class="card">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                
                                                <th> @Html.DisplayNameFor(model => model.Frist_Name)</th>
                                                <th> @Html.DisplayNameFor(model => model.Second_Name)</th>
                                                <th> @Html.DisplayNameFor(model => model.Third_Name)</th>
                                                <th> @Html.DisplayNameFor(model => model.Fourth_Name)</th>
                                                <th> @Html.DisplayNameFor(model => model.Nickname)</th>
                                                <th> @Html.DisplayNameFor(model => model.Number_card)</th>
                                                <th> @Html.DisplayNameFor(model => model.Img)</th>
                                                <th> @Html.DisplayNameFor(model => model.Cv)</th>
                                                <th> @Html.DisplayNameFor(model => model.Phone_number1)</th>
                                                <th> @Html.DisplayNameFor(model => model.Phone_number2)</th>
                                                <th> @Html.DisplayNameFor(model => model.Phone_number13)</th>
                                                <th> @Html.DisplayNameFor(model => model.User_type)</th>
                                            
                                                <th> العمليات</th>
                                                @*   <th>
                                                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exampleModalCenter"><i class="ti ti-user-plus me-1"></i>انشاء طلب </button>
                                                </th> *@

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id="row-@item.ID">

                                                    <td> @Html.DisplayFor(modelItem => item.Frist_Name) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Second_Name) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Third_Name) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Fourth_Name) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Nickname) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Number_card) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Img) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Cv) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Phone_number1) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Phone_number2) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.Phone_number13) </td>
                                                    <td> @Html.DisplayFor(modelItem => item.User_type) </td>
                                                       

                                               

                                                    <td>
                                                        <a href="#!"><i class="icon feather icon-edit f-w-600 f-16 m-r-15 text-success"></i></a><a href="#!"><i class="feather icon-trash-2 f-w-600 f-16 text-danger"></i></a>

                                                    </td>

                                                   


                                                </tr>
                                            }
                                        
                                        </tbody>
                                    </table>
                                </div>
                                <div id="contractAlertsContainer"
                                     style="position: fixed; bottom: 20px; right: 20px; z-index: 9999; cursor: pointer;">
                                </div>

                               
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>


    </div>
</div>



<!-- مكان عرض المودال -->
<div id="contractModalContainer"></div>
@section Scripts{
    <script>
        function submitForm(value) {
            document.getElementById('Is_Authentic').value = value;
            document.querySelector('#userDetailsModal form').submit();
        }
    </script>

   

} 