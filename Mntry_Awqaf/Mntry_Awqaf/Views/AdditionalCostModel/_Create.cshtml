<script>
    let rowIndex = 1; // لأن أول صف index = 0

    function addTableRow() {
        const tableBody = document.getElementById("templateTableBody");
        const rowCount = tableBody.rows.length + 1;

        const newRow = document.createElement("tr");

        newRow.innerHTML = `
            <td>${rowCount}</td>
            <td>
                <input name="AdditionalCostModeles[${rowIndex}].CostType" type="number"
                       class="form-control form-control-sm" placeholder="0.00">
            </td>
            <td>
                <input name="AdditionalCostModeles[${rowIndex}].Price" type="number"
                       class="form-control form-control-sm" placeholder="0.00">
            </td>
            <td>
                <input name="AdditionalCostModeles[${rowIndex}].Img" type="file"
                       class="form-control form-control-sm">
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeTableRow(this)">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        tableBody.appendChild(newRow);
        rowIndex++;
    }

    function removeTableRow(button) {
        const row = button.closest("tr");
        row.remove();

        // إعادة ترقيم العمود الأول (#) بعد الحذف
        const tableBody = document.getElementById("templateTableBody");
        Array.from(tableBody.rows).forEach((r, index) => {
            r.cells[0].textContent = index + 1;
        });
    }
</script>
 *@