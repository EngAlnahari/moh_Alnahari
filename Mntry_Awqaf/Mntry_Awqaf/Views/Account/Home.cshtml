@{
    ViewData["Title"] = "Home Page";
    Layout = "_Home";
}


<section class="key-features" dir="rtl">
        <div class="container title">
            <div class="row wow fadeInUp" data-wow-delay="0.2s">
                <div class="col-md-10 col-xl-4">
                    <h5 class="text-primary mb-0">Top Features</h5>
                    <h2 class="my-3">ماذا يقدم لك نظام تنجيز?</h2>
                    <p class="mb-0">
                    "دقة المسح وسرعة الحلول.. تجتمعان في منصتنا"
                    · "عالم العقارات المعقد.. ببساطة وثقة في منصة واحدة"
                    </p>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-sm-6 col-lg-4">
                    <div class="features-block text-center wow fadeInUp" data-wow-delay="0.4s">
                        <div class="avtar avtar-xl bg-light-primary">
                            <i class="material-icons-two-tone text-primary f-34">palette</i>
                        </div>
                    <h3 class="my-3"><b>مجموعة متكاملة من الخدمات المساحية</b></h3>
                    <p class="mb-0 text-muted">
                        "تخيل أن جميع حلولك العقارية بين يديك.. بدقة المحترفين"
                        · "من تحديد الحدود إلى فض النزاعات.. كل ما تحتاجه في مكان واحد".
                    </p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="features-block text-center wow fadeInUp" data-wow-delay="0.6s">
                        <div class="avtar avtar-xl bg-light-secondary">
                            <i class="material-icons-two-tone text-secondary f-34">reorder</i>
                        </div>
                    <h3 class="my-3"><b>البساطة والتكلفة</b></h3>
                    <p class="mb-0 text-muted">
                        · "لا تدفع أكثر مما يجب.. حلولنا ذكية وتكلفتها معقولة"
                       
                    </p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="features-block text-center wow fadeInUp" data-wow-delay="0.8s">
                        <div class="avtar avtar-xl bg-light-success">
                            <i class="material-icons-two-tone text-success f-34">speed</i>
                        </div>
                    <h3 class="my-3"><b> السهولة والكفاءة</b></h3>
                    <p class="mb-0 text-muted">
                        "بدون تعقيدات الإجراءات.. حلولنا تصل إليك أينما كنت"
                        · "ضغطة واحدة تفصلك عن حل نزاعك العقاري".
                    </p>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <section>
        <div class="container title">
            <div class="row">
                <div class="col-md-10 col-xl-4 wow fadeInUp" data-wow-delay="0.2s">
                    <h5 class="text-primary mb-0">Demos</h5>
                <h2 class="my-3">حل المشكلات</h2>
                    <p class="mb-0">
                    · "مشكلة في الحدود؟ نزاع في الملكية؟.. في منصة تنجيز لدينا الخبرة لحلها"

                    </p>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-sm-6 col-md-4">
                    <a href="dashboard/index.html" target="_blank">
                        <img src="~/assets/images/landing/img-demo-1.jpg" alt="img" class="rounded img-fluid mb-3 wow fadeInUp" data-wow-delay="0.2s">
                    </a>
                </div>
                <div class="col-sm-6 col-md-4">
                    <a href="application/social-profile.html" target="_blank">
                        <img src="~/assets/images/landing/img-demo-2.jpg" alt="img" class="rounded img-fluid mb-3 wow fadeInUp" data-wow-delay="0.4s">
                    </a>
                </div>
                <div class="col-sm-6 col-md-4">
                    <a href="application/mail.html" target="_blank">
                        <img src="~/assets/images/landing/img-demo-3.jpg" alt="img" class="rounded img-fluid mb-3 wow fadeInUp" data-wow-delay="0.4s">
                    </a>
                </div>
                <div class="col-12 mt-4 text-center wow fadeInUp" data-wow-delay="0.5s">
                    <button class="btn btn-outline-primary">Explore Components</button>
                </div>
            </div>
        </div>
    </section>


    <section class="layout">
        <div class="container">
            <div class="row align-items-center layout-block wow fadeInUp" data-wow-delay="0.2s">
                <div class="col-6">
                    <div class="layout-img-block">
                        <img src="~/assets/images/landing/img-layout1.png" alt="image" class="img-fluid img-layout">
                        <img src="~/assets/images/landing/img-layout1-bg.png" alt="image" class="img-fluid">
                    </div>
                </div>
                <div class="col-6">
                    <div class="layout-content">
                    <h4><b>التكامل والتمكين </b></h4>
                        <p class="text-muted">
                        · "منصتنا تجمع الدقة التقنية مع الحكمة القانونية.. لصالحك"

                            </p>
                    </div>
                </div>
            </div>
            <div class="row align-items-center layout-block wow fadeInUp" data-wow-delay="0.4s">
                <div class="col-6">
                    <div class="layout-content">
                    <h4><b>الدقة التقنية:</b></h4>
                    <p class="text-muted">
                        · "حدود واضحة.. ومستقبل آمن.. هذا ما نضمنه لك"
                    </p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="layout-img-block">
                        <img src="~/assets/images/landing/img-layout2.png" alt="image" class="img-fluid img-layout">
                        <img src="~/assets/images/landing/img-layout2-bg.png" alt="image" class="img-fluid">
                    </div>
                </div>
            </div>
            <div class="row align-items-center layout-block wow fadeInUp" data-wow-delay="0.6s">
                <div class="col-6">
                    <div class="layout-img-block">
                        <img src="~/assets/images/landing/img-layout3.png" alt="image" class="img-fluid img-layout">
                        <img src="~/assets/images/landing/img-layout3-bg.png" alt="image" class="img-fluid">
                    </div>
                </div>
                <div class="col-6">
                    <div class="layout-content">
                    <h4><b>فض النزاعات: </b></h4>
                    <p class="text-muted">
                        · "لا تدع النزاعات تعطل مستقبلك.. نحن الحل"
                    </p>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <section class="key-features">
        <div class="container title wow fadeInUp" data-wow-delay="0.2s">
            <div class="row">
                <div class="col-md-10 col-xl-4">
                    <h5 class="text-primary mb-0">Key Features</h5>
                <h2 class="my-3"> الرؤية الشاملة مع تنجيز</h2>
                    <p class="mb-0">
                    "نحن نؤمن بعقارات آمنة للجميع.. وهذا ما تحققه منصتنا"
                    · "رؤيتنا: تحويل التعقيد العقاري إلى فرص للجميع"

                    </p>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="0.4s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-primary">
                                <i class="material-icons-two-tone text-primary">folder</i>
                            </div>
                            <h5 class="mb-0 ms-3">Easy Folder Structure</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="0.6s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-secondary">
                                <i class="material-icons-two-tone text-secondary">code</i>
                            </div>
                            <h5 class="mb-0 ms-3">Organized Code Structure</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="0.8s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-primary">
                                <i class="material-icons-two-tone text-primary">insert_emoticon</i>
                            </div>
                            <h5 class="mb-0 ms-3">The Hassle-free Setup Process</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="1s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-secondary">
                                <i class="material-icons-two-tone text-secondary">lock_open</i>
                            </div>
                            <h5 class="mb-0 ms-3">3 Auth Methods</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="0.4s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-secondary">
                                <i class="material-icons-two-tone text-secondary">attachment</i>
                            </div>
                            <h5 class="mb-0 ms-3">React Hooks</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="0.6s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-primary">
                                <i class="material-icons-two-tone text-primary">call_split</i>
                            </div>
                            <h5 class="mb-0 ms-3">Code Splitting</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="0.8s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-secondary">
                                <i class="material-icons-two-tone text-secondary">text_fields</i>
                            </div>
                            <h5 class="mb-0 ms-3">Google Fonts</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="features-block wow fadeInUp" data-wow-delay="1s">
                        <div class="d-flex align-items-center">
                            <div class="avtar avtar-l bg-light-primary">
                                <i class="material-icons-two-tone text-primary">design_services</i>
                            </div>
                            <h5 class="mb-0 ms-3">Figma Design Files</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3 mt-md-5 wow fadeInUp" data-wow-delay="1s">
                <button class="btn btn-primary">Get Berry</button>
                <button class="btn btn-link-primary">Know More</button>
            </div>
        </div>
    </section>


    <section class="subscribe">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-5 text-end my-1">
                    <img src="~/assets/images/landing/img-groupmail.png" alt="logo" class="img-fluid img-mail">
                </div>
                <div class="col-lg-7 my-1">
                    <div class="subscribe-block wow zoomIn" data-wow-delay="0.6s">
                        <h2 class="mb-0">Subscribe</h2>
                        <p class="my-3 my-mb-4">
                            Subscribe for the latest news & updates of Berry admin template. We never send spam
                            newsletters.
                        </p>
                        <div class="media align-items-center">
                            <div class="media-body me-3">
                                <div class="form-floating mb-0">
                                    <input type="email" class="form-control" id="floatingaddcomment" placeholder="Email Address">
                                    <label for="floatingaddcomment">Email Address</label>
                                </div>
                            </div>
                            <button class="btn btn-primary btn-lg">Subscribe</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    