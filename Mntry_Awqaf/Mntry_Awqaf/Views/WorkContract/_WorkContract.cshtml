@model Mntry_Awqaf.Models.WorkContract
@{
    ViewData["Title"] = "بيانات المهندس";
}
<div class="contracts-list" dir="rtl">
    <!-- عقد 1 -->
    <div class="contract-card">

        <div class="contract-header">عقد عمل</div>

        <!-- بيانات العقد -->
        <div class="contract-section">
            <strong>تاريخ العقد:</strong> <span>2024-06-07</span> &nbsp; <strong>الوقت:</strong> <span>10:30 صباحًا</span>
        </div>

        @if (Model != null)
        {
            <div class="contract-section">
                <strong>الطرف الأول:</strong> <span> ...</span>
            </div>
            <div class="contract-section">
                <strong> اسم المهندس:</strong> <span> @(Model.FirstParty ?? "...")</span> &nbsp;
                <strong>رقم البطاقة الشخصية :</strong> <span></span>
            </div>
            <div class="contract-section">
                <strong>الطرف الثاني:</strong> <span> ...</span>
            </div>
            <div class="contract-section">
                <strong> اسم العميل:</strong> <span> @(Model.SecondParty ?? "...")</span> &nbsp;
                <strong> رقم البطاقة:</strong> <span></span>
            </div>
            <div class="contract-section">
                <strong> على التالي:</strong> <span> ...</span>
            </div>

            <!-- حاوية البنود -->
            <div id="contractItemsContainer">
                @if (Model.ContractItems != null && Model.ContractItems.Any())
                {
                    foreach (var item in Model.ContractItems.OrderBy(x => x.Count))
                    {
                        <div class="contract-section">
                            <strong>@item.Count- @item.Title:</strong>
                            @if (!string.IsNullOrEmpty(item.DescriptionTemplate))
                            {
                                @Html.Raw(item.DescriptionTemplate.Replace("<br/>", "<div></div>"))
                            }
                        </div>
                    }
                }
            </div>






        }
        else
        {
            <p>لا توجد بيانات للطلب.</p>
        }


        <!-- نموذج الموافقة على العقد -->
