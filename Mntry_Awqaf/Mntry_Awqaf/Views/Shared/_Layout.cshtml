    <script>
        document.addEventListener('DOMContentLoaded', function() {
    const table = document.getElementById('earthBordersTable');
    if (!table) return; // الخروج إذا لم يكن الجدول موجوداً

    // دالة لتحديث حالة الحقل حسب checkbox
    function updateDifferenceInput(row) {
        const checkbox = row.querySelector('input[type="checkbox"]');
        const differenceInput = row.querySelector('input[name$=".Difference"]');
        if(checkbox && checkbox.checked) {
            differenceInput?.removeAttribute('readonly');
        } else {
            differenceInput?.setAttribute('readonly', true);
            if (differenceInput) differenceInput.value = ''; // مسح القيمة عند إلغاء التحديد
        }
    }

    // تطبيق على جميع الصفوف الحالية
    const rows = table.querySelectorAll('tbody tr');
    rows.forEach(row => {
        const checkbox = row.querySelector('input[type="checkbox"]');
        updateDifferenceInput(row); // تهيئة حالة الحقل
        checkbox.addEventListener('change', function() {
            updateDifferenceInput(row);
        });
    });

    // إذا كنت تريد دعم إضافة صفوف جديدة
    document.getElementById('addBorderRow').addEventListener('click', function() {
        const newRow = rows[0].cloneNode(true); // نسخ أول صف كمثال
        table.querySelector('tbody').appendChild(newRow);
        const checkbox = newRow.querySelector('input[type="checkbox"]');
        const differenceInput = newRow.querySelector('input[name$=".Difference"]');
        differenceInput.value = '';
        differenceInput.setAttribute('readonly', true);
        checkbox.checked = false;
        checkbox.addEventListener('change', function() {
            updateDifferenceInput(newRow);
        });
    });
});

        document.addEventListener('DOMContentLoaded', function() {
            const descripSelect = document.getElementById('descripSelect');
            const modalEl = document.getElementById('agentModal');
            
            if (!descripSelect || !modalEl) return; // الخروج إذا لم تكن العناصر موجودة
            
            const agentModal = new bootstrap.Modal(modalEl);

            descripSelect.addEventListener('change', function() {
                if (this.value === 'وكيل') {
                    agentModal.show();
                    this.value = ''; // إعادة تعيين القيمة بعد الفتح
                }
            });

            document.getElementById('saveAgentBtn').addEventListener('click', function() {
                const agentValue = document.getElementById('agentNameOrNumber').value;
                if(agentValue.trim() !== '') {
                    document.getElementById('hiddenAgentField').value = agentValue;
                }
                agentModal.hide();
            });
        });
    </script>
   

    <script>
        function showContractAlert() {
