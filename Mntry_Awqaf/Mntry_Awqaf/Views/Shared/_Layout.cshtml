    <script>
        // دالة لعرض الفورم داخل المودال
        function showFormDialog(controllerName, id = null) {
            let url = id ? `/${controllerName}/Edit/${id}` : `/${controllerName}/Create`;

            fetch(url)
                .then(res => res.text())
                .then(html => {
                    // إدراج محتوى الـ PartialView داخل المودال
                    document.getElementById("editPartialContainer").innerHTML = html;

                    let modalElement = document.getElementById("editModal");
                    let modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modalInstance.show();

                    // تهيئة الجدول والدوال (من الصفحة الأم)
                    if (typeof initModalTable === "function") {
                        initModalTable();
                    }

                    // ربط حدث submit للفورم
                    let form = document.getElementById("formModal");
                    if (!form) return;

                    // إزالة أي مستمعين سابقين لتجنب تكرار الرسائل
                    form.replaceWith(form.cloneNode(true));
                    form = document.getElementById("formModal");

                    form.addEventListener("submit", function(e) {
                        e.preventDefault();
                        let formData = new FormData(form);

                        fetch(form.action, {
                            method: form.method,
                            body: formData
                        })
                        .then(res => res.json())
                        .then(data => {
                            let msgDiv = form.querySelector("#formMessages");
                            if (!msgDiv) {
                                msgDiv = document.createElement("div");
                                msgDiv.id = "formMessages";
                                form.prepend(msgDiv);
                            }

                            if (data.success) {
                                msgDiv.innerHTML = `<div class="alert alert-success">${data.message}</div>`;

                                // اغلاق المودال بعد ثانيتين
                                setTimeout(() => {
                                    msgDiv.innerHTML = "";
                                    modalInstance.hide();
                                }, 2000);

                            } else {
                                msgDiv.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                                setTimeout(() => { msgDiv.innerHTML = ""; }, 3000);
                            }
                        })
                        .catch(err => {
                            let msgDiv = form.querySelector("#formMessages");
                            if (!msgDiv) {
                                msgDiv = document.createElement("div");
                                msgDiv.id = "formMessages";
                                form.prepend(msgDiv);
                            }
                            msgDiv.innerHTML = `<div class="alert alert-danger">⚠️ خطأ بالشبكة: ${err.message}</div>`;
                            setTimeout(() => { msgDiv.innerHTML = ""; }, 3000);
                            console.error(err);
                        });

                    }, { once: true }); // الحدث ينفذ مرة واحدة فقط
                })
                .catch(err => {
                    document.getElementById("editPartialContainer").innerHTML =
                        '<p class="text-danger">حدث خطأ أثناء تحميل الفورم.</p>';
                    console.error(err);
                });
        }
    </script>





