 @model Mntry_Awqaf.Models.WorkOfferWithDetailsViewModel

@{
    Layout = null;
    ViewData["Title"] = "Create Work Offer";
}

<form id="createWorkOfferForm" action="@Url.Action("Create", "WorkWagesTemplate")" method="post">

    <div class="modal-body">
        <div class="row mb-3">
        @{
            var rop = Context.Session.GetInt32("UserID");
        }
      
            <!-- اسم القالب -->
           @*  <div class="col-md-4">
                <label asp-for="OfferType.WorkWagesName" class="form-label">اسم القالب</label>
                <input asp-for="OfferType.WorkWagesName" type="text" class="form-control" placeholder="أدخل اسم القالب">
            </div> *@
            <div class="col-md-4">
                <label asp-for="OfferType.WorkWagesName" class="form-label">اسم القالب</label>

                <!-- حقل إدخال مع قائمة اقتراحات -->
                <input asp-for="OfferType.WorkWagesName"
                       type="text"
                       class="form-control"
                       list="wagesTemplatesList"
                       placeholder="أدخل اسم القالب أو اختر من القائمة">

                <!-- قائمة الاقتراحات -->
                <datalist id="wagesTemplatesList">
                    @foreach (var item in (SelectList)ViewBag.WagesTemplate)
                    {
                        <option value="@item.Text"></option>
                    }
                </datalist>
            </div>


            <!-- نوع العمل -->
            <div class="col-md-4">
                <label asp-for="OfferType.WorkWagesType" class="form-label">Work Wages Type</label>
               <select asp-for="OfferType.WorkWagesType" 
        class="form-select wagesTypeSelect"
                        onchange="updateTyValue(this)" id="wagesTypeSelect" id="extraChargesSelect1">
    <option value="">اختر النوع</option>
    <option value="مقطوعة">مقطوعة</option>
    <option value="يومية">يومية</option>
    <option value="بالإنجاز (حسب المساحة)">بالإنجاز (حسب المساحة)</option>
</select>

            </div>
           
            <div class="col-md-4 d-flex align-items-center">
                <div class="form-check mt-4">
                    <!-- هذه القيمة تُرسل دائمًا -->
                    <input type="hidden" name="OfferType.EachTypeSimilar" value="0" />

                    <!-- إذا تم التشييك على الـ checkbox يتم إرسال القيمة 1 -->
                    <input type="checkbox"
                           name="OfferType.EachTypeSimilar"
                           value="1"
                           class="form-check-input"
                           id="IsAllTypesIncluded" />

                    <label class="form-check-label ms-2" for="IsAllTypesIncluded">
                        شامل لكل الأنواع
                    </label>
                </div>

            <input asp-for="OfferType.UserID" type="hidden" value="@rop" />
        </div>
        </div>

       
    
        </div>

        <!-- استدعاء الجدول WorkWagesTaple -->
        @await Html.PartialAsync("~/Views/WorkWagesTaple/Create.cshtml")


    </div>
    <div id="modalMessage" class="w-100 mb-2"></div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button type="submit" class="btn btn-primary">حفظ القالب</button>
    </div>
  

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

</form>

