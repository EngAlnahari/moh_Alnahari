                    return acc;
                }, {})),
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    form.reset();
                    // إخفاء collapse
                    bootstrap.Collapse.getInstance(document.getElementById("extraTypeModeContainer"))?.hide();
                } else {
                    alert("❌ فشل الحفظ");
                }
            })
            .catch(err => {
                console.error(err);
                alert("❌ حدث خطأ أثناء الحفظ");
