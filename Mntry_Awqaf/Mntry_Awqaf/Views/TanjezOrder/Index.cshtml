    <script>
        const familyTree = [];

        function capitalize(s){ return s.charAt(0).toUpperCase() + s.slice(1); }

        function enableInput(level){
            document.getElementById('select'+capitalize(level)+'Modal').classList.add('d-none');
            const input = document.getElementById('input'+capitalize(level)+'Modal');
            input.classList.remove('d-none');
            input.focus();
        }

        function getSelectedOrInput(level){
            const select = document.getElementById('select'+capitalize(level)+'Modal');
            const input = document.getElementById('input'+capitalize(level)+'Modal');
            return input.value.trim() || select.value;
        }

        function populateSelect(selectElement, items){
            selectElement.innerHTML = '<option value="">اختر</option>';
            items.forEach(item=>{
                const opt = document.createElement('option');
                opt.value = item.name;
                opt.textContent = item.name;
                selectElement.appendChild(opt);
            });
        }

        // تحديث قائمة فرعية في المودال حسب العنصر الأب
        function updateChildSelects(childId, parentId, sourceArray){
            const childSelect = document.getElementById(childId);
            const parentSelect = document.getElementById(parentId);
            const selectedParent = parentSelect.value;
            let items = [];
            if(selectedParent){
                const parentNode = sourceArray.find(x=>x.name===selectedParent);
                if(parentNode && parentNode.children) items = parentNode.children;
            }
            populateSelect(childSelect, items);
        }

        function updateModalSelects(){
            // تعبئة الجدود
            populateSelect(document.getElementById('selectGrandParentModal'), familyTree);
            // عند اختيار الجد → عرض الآباء
            updateChildSelects('selectParentModal','selectGrandParentModal', familyTree);
            // عند اختيار الأب → عرض الأبناء
            const selectedGP = document.getElementById('selectGrandParentModal').value;
            const gpNode = familyTree.find(x=>x.name===selectedGP);
            updateChildSelects('selectChildModal','selectParentModal', gpNode?gpNode.children:[]);
            // الابن → أبناءه
            const selectedP = document.getElementById('selectParentModal').value;
            const pNode = gpNode && selectedP ? gpNode.children.find(x=>x.name===selectedP):null;
            updateChildSelects('selectGrandChildModal','selectChildModal', pNode?pNode.children:[]);
            // ابن الابن → أبناءه
            const selectedC = document.getElementById('selectChildModal').value;
            const cNode = pNode && selectedC ? pNode.children.find(x=>x.name===selectedC):null;
            updateChildSelects('selectGreatGrandChildModal','selectGrandChildModal', cNode?cNode.children:[]);
        }

        function updateMainSelects(){
            const gpSelect = document.getElementById('grandParent');
            const pSelect = document.getElementById('parent');
            const cSelect = document.getElementById('child');
            const gcSelect = document.getElementById('grandChild');
            const ggcSelect = document.getElementById('greatGrandChild');

            populateSelect(gpSelect, familyTree);

            const selectedGP = gpSelect.value;
            const gpNode = familyTree.find(x => x.name === selectedGP);
            populateSelect(pSelect, gpNode ? gpNode.children : []);

            const selectedP = pSelect.value;
            const pNode = gpNode && selectedP ? gpNode.children.find(x => x.name === selectedP) : null;
            populateSelect(cSelect, pNode ? pNode.children : []);

            const selectedC = cSelect.value;
            const cNode = pNode && selectedC ? pNode.children.find(x => x.name === selectedC) : null;
            populateSelect(gcSelect, cNode ? cNode.children : []);

            const selectedGC = gcSelect.value;
            const gcNode = cNode && selectedGC ? cNode.children.find(x => x.name === selectedGC) : null;
            populateSelect(ggcSelect, gcNode ? gcNode.children : []);
        }

        document.getElementById('saveFamilyBtn').addEventListener('click', ()=>{
            const gParent = getSelectedOrInput('grandParent');
            if(!gParent) return alert("يجب إدخال اسم الجد");

            const parent = getSelectedOrInput('parent');
            const child = getSelectedOrInput('child');
            const gChild = getSelectedOrInput('grandChild');
            const ggChild = getSelectedOrInput('greatGrandChild');

            let gParentNode = familyTree.find(x=>x.name===gParent);
            if(!gParentNode){ gParentNode={name:gParent,children:[]}; familyTree.push(gParentNode); }

            if(parent){
                let parentNode = gParentNode.children.find(x=>x.name===parent);
                if(!parentNode){ parentNode={name:parent,children:[]}; gParentNode.children.push(parentNode); }

                if(child){
                    let childNode = parentNode.children.find(x=>x.name===child);
                    if(!childNode){ childNode={name:child,children:[]}; parentNode.children.push(childNode); }

                    if(gChild){
                        let gChildNode = childNode.children.find(x=>x.name===gChild);
                        if(!gChildNode){ gChildNode={name:gChild,children:[]}; childNode.children.push(gChildNode); }

                        if(ggChild){
                            let ggChildNode = gChildNode.children.find(x=>x.name===ggChild);
                            if(!ggChildNode){ ggChildNode={name:ggChild,children:[]}; gChildNode.children.push(ggChildNode); }
                        }
                    }
                }
            }

            // إعادة الحقول لحالتها الطبيعية
            ['grandParent','parent','child','grandChild','greatGrandChild'].forEach(level=>{
                const select = document.getElementById('select'+capitalize(level)+'Modal');
                const input = document.getElementById('input'+capitalize(level)+'Modal');
                if(select && input){
                    input.value='';
                    input.classList.add('d-none');
                    select.classList.remove('d-none');
                }
            });

            updateModalSelects();
            updateMainSelects();
            bootstrap.Modal.getInstance(document.getElementById('addFamilyModal')).hide();
        });

        // ربط الأحداث الرئيسية
        document.getElementById('grandParent').addEventListener('change', updateMainSelects);
        document.getElementById('parent').addEventListener('change', updateMainSelects);
        document.getElementById('child').addEventListener('change', updateMainSelects);
        document.getElementById('grandChild').addEventListener('change', updateMainSelects);

        document.getElementById('addMemberBtn').addEventListener('click', updateModalSelects);
    </script> *@



