                        <thead>
                            <tr>
                                <th>رقم الطلب</th>
                                @if (ViewBag.DynamicFields != null)
                                {
                                    foreach (var field in ViewBag.DynamicFields)
                                    {
                                        <th>@field.Name</th>
                                    }
                                }
                                <th>العمليات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                                                <tr id="row-@item.Id">
                                    <td>@item.Id</td>

                                    @if (ViewBag.DynamicFields != null)
                                    {
                                        foreach (var field in ViewBag.DynamicFields)
                                        {
                                            int fId = (int)field.Id;
                                            var val = dynamicValues?.FirstOrDefault(v => v.RecordId == item.Id && v.DynamicFieldId == fId)?.Value ?? "-";
                                            string fieldType = (string)field.Type;

                                            if (fieldType == "file" && val != "-" && val != "")
                                            {
                                                // تحديد نوع الملف
                                                string ext = System.IO.Path.GetExtension(val).ToLower();
                                                bool isImage = ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".bmp" || ext == ".webp" || ext == ".svg";

                                                if (isImage)
                                                {
                                                    <td>
                                                        <a href="@val" target="_blank" title="عرض الصورة">
                                                            <img src="@val" alt="مرفق" style="width:55px;height:55px;object-fit:cover;border-radius:5px;border:1px solid #ccc;" 
                                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='inline'" />
                                                            <span style="display:none">🖼️ <small>@System.IO.Path.GetFileName(val)</small></span>
                                                        </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        <a href="@val" target="_blank" title="فتح المرفق" style="text-decoration:none; color:#0d6efd;">
                                                            📎 <small>@System.IO.Path.GetFileName(val)</small>
                                                        </a>
                                                    </td>
                                                }
                                            }
                                            else
                                            {
                                                <td>@val</td>
                                            }
                                        }
                                    }
                                    <td>
                                        <a href="/TanjezOrder/Edit/@item.Id" title="تعديل" class="me-2">
                                            <i class="icon feather icon-edit f-w-600 f-16 text-success"></i>
                                        </a>
                                        <a href="#" title="حذف"
                                           onclick="confirmDelete(@item.Id); return false;">
                                            <i class="feather icon-trash-2 f-w-600 f-16 text-danger"></i>
                                        </a>
                                    </td>
                                </tr>
