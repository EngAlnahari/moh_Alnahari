@section Scripts {

    <script>
        document.querySelectorAll('.show-borders').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const orderId = this.dataset.orderId;

                fetch(`/TanjezOrder/GetBorders?orderId=${orderId}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('bordersModalBody').innerHTML = html;
                        const myModal = new bootstrap.Modal(document.getElementById('bordersModal'));
                        myModal.show();
                    })
                    .catch(err => console.error("حدث خطأ أثناء التحميل: ", err));
            });
        });


                    document.addEventListener("DOMContentLoaded", function () {

            const buttons = document.querySelectorAll(".create-contract-btn");

            buttons.forEach(btn => {
                btn.addEventListener("click", function () {

                    // ملء الحقول الثابتة
                    $('#orderId').val(this.dataset.orderId);
                    $('#type').val(this.dataset.type);
                    $('#space').val(this.dataset.space);
                    $('#governorateParam').val(this.dataset.governorate);
                    $('#transportation').val(this.dataset.transportation || 0);
                    $('#overnight').val(this.dataset.overnight || 0);
                    $('#allowance').val(this.dataset.allowance || 0);

                    // تهيئة Select2
                    if (!$('#engineerId').hasClass("select2-hidden-accessible")) {
                        $('#engineerId').select2({
                            placeholder: 'ادخل اسم المستخدم أو رقم الجوال',
                            minimumInputLength: 1,
                            dropdownParent: $('#createContractModal'),
                            language: {
                                inputTooShort: () => 'الرجاء إدخال حرف واحد على الأقل',
                                noResults: () => 'لم يتم العثور على نتائج',
                                searching: () => 'جاري البحث...'
                            },
                            ajax: {
                                url: '/TanjezOrder/GetUsers',
                                dataType: 'json',
                                delay: 250,
                                data: params => ({ term: params.term }),
                                processResults: data => ({
                                    results: data.map(x => ({
                                        id: x.id,
                                        text: x.text + (x.phone ? ' - ' + x.phone : '')
                                    }))
                                }),
                                cache: true
                            }
                        });
                    }

                    // عند اختيار المستخدم، تحميل العروض المرتبطة
                    $('#engineerId').off('change').on('change', function () {
                        const userId = $(this).val();
                        $('#offerId').empty().append('<option value="">-- اختر العرض --</option>');

                        if (userId) {
                            $.getJSON(`/TanjezOrder/GetUserOffers/${userId}`, function (data) {
                                if (data.workOffers && data.workOffers.length > 0) {
                                    data.workOffers.forEach(offer => {
                                        $('#offerId').append(`<option value="${offer.id}">${offer.id} - ${offer.offerName}</option>`);
                                    });
                                }
                            });
                        }
                    });

                    // إظهار المودال
                    const modal = new bootstrap.Modal(document.getElementById("createContractModal"));
                    modal.show();
                });
            });
        });





    </script>

<script>
        $('#viewContractModal').on('hidden.bs.modal', function () {
