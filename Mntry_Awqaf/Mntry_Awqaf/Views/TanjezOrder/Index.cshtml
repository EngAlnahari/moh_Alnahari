    <script>
        // دالة عرض الرسالة
        function showContractAlert() {
            var alertEl = document.getElementById('contractAlert');
            if (alertEl) {
                var bsAlert = new bootstrap.Alert(alertEl);
                alertEl.classList.add("show");   // يضيف الكلاس show لعرض التنبيه
            }
        }

        // عند تحميل الصفحة مباشرة
        document.addEventListener("DOMContentLoaded", function () {
            showContractAlert();
        });

        // عند الضغط على الرسالة يفتح المودال
        var contractAlertEl = document.getElementById('contractAlert');
        if (contractAlertEl) {
            contractAlertEl.addEventListener('click', function (e) {
                if (!e.target.classList.contains('btn-close')) {
                    var modalEl = document.getElementById('viewContractModal');
                    if (modalEl) {
                        var modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                }
            });
        }
    </script>


