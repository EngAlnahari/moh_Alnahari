<script>
    // استخدام جافا سكربت نقية لتجنب مشكلة عدم تحميل مكتبة jQuery في هذا الجزء من الصفحة
    (function () {
        function initTempMessage() {
            var tempMsg = document.getElementById('temp-message');
            if (tempMsg) {
                setTimeout(function () {
                    tempMsg.style.transition = "opacity 1s ease";
                    tempMsg.style.opacity = 0;
                    setTimeout(function () {
                        tempMsg.remove();
                    }, 1000);
                }, 9000);
            }
        }
        if (document.readyState === "loading") {
            document.addEventListener('DOMContentLoaded', initTempMessage);
        } else {
            initTempMessage();
        }
    })();

    // ===== حذف السجل =====
    var _deleteId = 0;
    var _deleteModalInstance = null;

    function confirmDelete(id) {
        _deleteId = id;
        var modalEl = document.getElementById('deleteConfirmModal');
        if (modalEl) {
            _deleteModalInstance = bootstrap.Modal.getInstance(modalEl);
            if (!_deleteModalInstance) {
                _deleteModalInstance = new bootstrap.Modal(modalEl);
            }
            _deleteModalInstance.show();
        }
    }

    // استخدام مفوض الأحداث (Event Delegation) لضمان العمل دائماً بغض النظر عن وقت تحميل الصفحة أو السكربت
    document.addEventListener('click', function (e) {
        if (e.target && e.target.id === 'confirmDeleteBtn') {
            var btn = e.target;
            btn.disabled = true; // تعطيل الزر لتجنب النقرات المتكررة
            
            fetch('/TanjezOrder/DeleteConfirmed?id=' + _deleteId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(function(r) {
                btn.disabled = false;
                if (!r.ok) {
                    showAlert('danger', 'خطأ في الخادم: ' + r.status);
                    if (_deleteModalInstance) _deleteModalInstance.hide();
                    return null;
                }
                return r.json();
            })
            .then(function(data) {
                if (!data) return;
                if (_deleteModalInstance) _deleteModalInstance.hide();
                if (data.success) {
                    var row = document.getElementById('row-' + _deleteId);
                    if (row) row.remove();
                    showAlert('success', data.message);
                } else {
                    showAlert('danger', data.message);
                }
            })
            .catch(function(err) { 
                btn.disabled = false;
                if (_deleteModalInstance) _deleteModalInstance.hide();
                showAlert('danger', 'حدث خطأ: ' + err.message); 
            });
        }
    });

    function showAlert(type, msg) {
        var div = document.createElement('div');
        div.className = 'alert alert-' + type + ' alert-dismissible fade show';
        div.style = 'position:fixed;top:20px;right:20px;z-index:9999;min-width:250px;';
        div.innerHTML = msg + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
        document.body.appendChild(div);
        setTimeout(function() { div.remove(); }, 4000);
    }
</script>

