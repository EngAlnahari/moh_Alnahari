                            <input type="text" id="inputGrandParentModal" class="form-control d-none" placeholder="أدخل اسم جديد">
                            <button class="btn btn-outline-secondary" onclick="enableInput('grandParent')">+</button>
                        </div>
                    </div>
                    <!-- الأب -->
                    <div class="mb-2">
                        <label>الأب</label>
                        <div class="input-group">
                            <select id="selectParentModal" class="form-select"></select>
                            <input type="text" id="inputParentModal" class="form-control d-none" placeholder="أدخل اسم جديد">
