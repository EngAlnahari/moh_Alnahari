    $(document).ready(function () {
        $(document).on('click', '.view-contract-btn', function (e) {
            e.preventDefault();
            var contractId = $(this).data('contract-id');
            var modalBody = $('#viewContractModal').find('.modal-body');
            
            modalBody.html('<div class="text-center p-3"><span class="spinner-border"></span></div>');
            
            var modal = new bootstrap.Modal(document.getElementById('viewContractModal'));
            modal.show();
            
            $.get('/User/GetWorkContract', { contractId: contractId }, function (data) {
                modalBody.html(data);
            }).fail(function () {
                modalBody.html('<div class="alert alert-danger m-3">فشل تحميل تفاصيل العقد.</div>');
            });
        });
    });

</script>
