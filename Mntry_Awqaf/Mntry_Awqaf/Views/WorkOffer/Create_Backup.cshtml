<script>
    // نستخدم هذه المتغيرات لتعقب عدد الصفوف
    let rowIndex = 0; // سيتم تحديثه عند فتح المودال بعد تحميل PartialView

    // دالة لإعادة حساب الإجمالي
    function updateTotal() {
        let total = 0;
        document.querySelectorAll(".price-input").forEach(input => {
            let value = parseFloat(input.value) || 0;
            total += value;
        });

        const totalCell = document.getElementById("totalPrice");
        if (totalCell) {
            totalCell.textContent = total.toFixed(2);

            // تأثير بصري عند تغير المجموع
            totalCell.style.transition = "background-color 0.3s";
            totalCell.style.backgroundColor = "#dc3545"; // لون أحمر
            setTimeout(() => {
                totalCell.style.backgroundColor = ""; // إعادة اللون الأصلي
            }, 300);
        }
    }

    // دالة لإضافة صف جديد في الجدول
    function addTableRow() {
        const tableBody = document.getElementById("templateTableBody");
        if (!tableBody) return;

        const rowCount = tableBody.rows.length + 1;
        const newRow = document.createElement("tr");

        newRow.innerHTML = `
            <td>${rowCount}</td>
            <td><input name="AdditionalCostModeles[${rowIndex}].CostType" type="text" class="form-control form-control-sm"></td>
            <td><input name="AdditionalCostModeles[${rowIndex}].Price" type="number" class="form-control form-control-sm price-input" placeholder="0.00" oninput="updateTotal()"></td>
            <td><input name="AdditionalCostModeles[${rowIndex}].Img" type="text" class="form-control form-control-sm"></td>
            <td>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeTableRow(this)">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;
        tableBody.appendChild(newRow);
        rowIndex++;
        updateTotal();
    }

    // دالة لحذف صف من الجدول
    function removeTableRow(button) {
        const row = button.closest("tr");
        if (!row) return;

        row.remove();

        const tableBody = document.getElementById("templateTableBody");
        if (!tableBody) return;

        // إعادة ترقيم الصفوف
        Array.from(tableBody.rows).forEach((r, index) => r.cells[0].textContent = index + 1);
        updateTotal();
    }

    // تحديث rowIndex عند تحميل المودال بالـ PartialView
    function initModalTable() {
        const tableBody = document.getElementById("templateTableBody");
        if (!tableBody) return;

        // نأخذ عدد الصفوف الحالي في الجدول لتحديث rowIndex
        rowIndex = tableBody.rows.length;

        // تحديث الإجمالي عند تحميل المودال
        updateTotal();
    }

    // نربط هذه الدالة عند فتح المودال بعد تحميل PartialView
    document.addEventListener("DOMContentLoaded", () => {
        // يمكن استدعاؤها مباشرة إذا كان هناك جدول موجود عند تحميل الصفحة
        initModalTable();
    });
</script>






    <script>
