<script>
    document.getElementById("transportTemplateSelect1").addEventListener("change", function () {
        if (this.value === "create-new-template1") {
            loadTransportTemplate();
        }
    });

    function loadTransportTemplate() {
        fetch('/WorkWagesTemplate/Create')
            .then(response => response.text())
            .then(html => {
                document.getElementById("transportTemplateContent").innerHTML = html;

                // ربط الفورم و AJAX
                bindWorkOfferForm();
                bindInnerCollapseForm();
                initTransportTemplateEvents();

                // عرض المودال
                var myModal = new bootstrap.Modal(document.getElementById('transportTemplateModal'));
                myModal.show();
            });
    }

    function bindWorkOfferForm() {
        var $form = $("#createWorkOfferForm");
        if ($form.length) {
            $form.off("submit").on("submit", function (e) {
                e.preventDefault();
                $.ajax({
                    url: $form.attr("action"),
                    type: $form.attr("method"),
                    data: $form.serialize(),
                    dataType: "json",
                    success: function (res) {
                        if (res.success) {
                            $("#modalMessage").html('<div class="alert alert-success">' + res.message + '</div>');

                            // تحديث محتوى المودال فقط بعد 2 ثانية
                            setTimeout(function() {
                                $("#transportTemplateContent").load('/WorkWagesTemplate/Create', function () {
                                    bindWorkOfferForm();
                                    bindInnerCollapseForm();
                                    initTransportTemplateEvents();
                                });
                            }, 2000);

                        } else {
                            $("#modalMessage").html('<div class="alert alert-danger">' + res.message + '</div>');
                        }
                    },
                    error: function () {
                        $("#modalMessage").html('<div class="alert alert-danger">حدث خطأ أثناء الاتصال بالخادم</div>');
                    }
                });
            });
        }
    }

    function bindInnerCollapseForm() {
        var $innerForm = $("#specificSpaceTemplateForm");
        if ($innerForm.length) {
            $innerForm.off("submit").on("submit", function (e) {
                e.preventDefault();
                $.ajax({
                    url: $innerForm.attr("action"),
                    type: $innerForm.attr("method"),
                    data: $innerForm.serialize(),
                    dataType: "json",
                    success: function (res) {
                        if (res.success) {
                            var collapse = bootstrap.Collapse.getInstance(document.getElementById("extraTypeModeContainer"));
                            if (collapse) collapse.hide();
                            $("#modalMessage").html('<div class="alert alert-success">' + res.message + '</div>');

                            // ✅ تعيين ID فقط للصف المخزن
                            var currentRow = $("#specificSpaceTemplateForm").data("currentRow");
                            if (res.newId && currentRow) {
                                $(currentRow).find("input[name$='.AlmjalID']").val(res.newId);
                            }

                        } else {
                            $("#modalMessage").html('<div class="alert alert-danger">' + res.message + '</div>');
                        }
                    },
                    error: function () {
                        $("#modalMessage").html('<div class="alert alert-danger">حدث خطأ أثناء الاتصال بالخادم</div>');
                    }
                });
            });
        }
    }

    // إعادة ربط جميع الأحداث داخل المودال
    function initTransportTemplateEvents() {
        // تحديث الحقول المخفية .tyInput عند تغيير نوع الأجور
        var wagesTypeSelect = document.getElementById("wagesTypeSelect");
        if (wagesTypeSelect) {
            wagesTypeSelect.addEventListener("change", function () {
                var selectedValue = this.value;
                document.querySelectorAll("#createWorkOfferForm .tyInput").forEach(function(input) {
                    input.value = selectedValue;
                });

                // التحكم بعرض أعمدة المساحة
                var spaceColumns = document.querySelectorAll(".space-column");
                if (selectedValue === "مقطوعة" || selectedValue === "يومية") {
                    spaceColumns.forEach(col => col.style.display = "none");
                } else if (selectedValue === "بالإنجاز (حسب المساحة)") {
                    spaceColumns.forEach(col => col.style.display = "table-cell");
                }
            });
        }

        // checkbox
        var checkBox = document.getElementById("IsAllTypesIncluded");
        if (checkBox) {
            checkBox.addEventListener("change", function () {
                var table1 = document.getElementById("table1");
                var table2 = document.getElementById("table2");
                if (this.checked) {
                    table1.style.display = "none";
                    table2.style.display = "block";
                } else {
                    table1.style.display = "block";
                    table2.style.display = "none";
                }
            });
        }

        // التحكم بين السعر وجدول الأسعار
               document.querySelectorAll(".transportTemplateSelect11").forEach(function (selectInner) {
        selectInner.addEventListener("change", function () {
            var currentRow = this.closest("tr"); // الصف الحالي

            var priceCell = currentRow.querySelector("td[data-col='price']");
            var priceTapleCell = currentRow.querySelector("td[data-col='priceTaple']");
            var priceHeader = document.getElementById("priceHeader");

            if (this.value === "مساحة مفتوحة") {
                if (priceCell) {
                    let input = priceCell.querySelector("input");
                    if (input) input.style.display = "block"; // عرض المحتوى
                }
                if (priceTapleCell) priceTapleCell.style.display = "none"; // يظل مخفي دائمًا

                if (priceHeader) {
                    var selectedText = this.options[this.selectedIndex].text;
                    if (selectedText.includes("مساحة مفتوحة")) {
                        priceHeader.textContent = "اجمالي السعر ";
                    } else if (selectedText.includes("متر")) {
                        priceHeader.textContent = "السعر لكل متر مربع ";
                    } else {
                        priceHeader.textContent = "السعر";
                    }
                }
            }
            else if (this.value === "مساحة محددة") {
                if (priceCell) {
                    let input = priceCell.querySelector("input");
                    if (input) input.style.display = "none"; // اخفاء فقط محتوى الخلية
                }
                if (priceTapleCell) priceTapleCell.style.display = "none"; // يظل مخفي دائمًا

                // 👇 فتح المودال/الفورم الفرعي فقط
                fetch('/SpecificSpaceTemplate/Create')
                    .then(res => res.text())
                    .then(html => {
                        document.querySelector("#extraTypeModeContainer .card-body").innerHTML = html;

                        var hiddenInput = document.getElementById("almjalHiddenInput");
                        if (hiddenInput) hiddenInput.value = currentRow.querySelector("input[name^='WorkWages'][name$='EachTypeSimilar']").value;

                        $("#specificSpaceTemplateForm").data("currentRow", currentRow);

                        new bootstrap.Collapse(document.getElementById("extraTypeModeContainer"), { toggle: true });
                        bindInnerCollapseForm();
                    });
            }
            else {
                if (priceCell) {
                    let input = priceCell.querySelector("input");
                    if (input) input.style.display = "block"; // عرض مرة أخرى
                }
                if (priceTapleCell) priceTapleCell.style.display = "none"; // يظل مخفي دائمًا
                if (priceHeader) priceHeader.textContent = "السعر";

                var collapse = bootstrap.Collapse.getInstance(document.getElementById("extraTypeModeContainer"));
                if (collapse) collapse.hide();
            }
        });
    });


    }
</script>
<script>
    // متغير لمنع الإرسال المتكرر
    let isSubmitting = false;

    function bindWorkOfferForm() {
        var $form = $("#createWorkOfferForm");
        if ($form.length) {
            $form.off("submit").on("submit", function (e) {
                e.preventDefault();
                e.stopImmediatePropagation(); // يمنع أي حدث submit آخر مرتبط بنفس الفورم

                if (isSubmitting) return; // إذا كان الإرسال جاري، يمنع التكرار
                isSubmitting = true;

                $.ajax({
                    url: $form.attr("action"),
                    type: $form.attr("method"),
                    data: $form.serialize(),
                    dataType: "json",
                    success: function (res) {
                        if (res.success) {
                            $("#modalMessage").html('<div class="alert alert-success">' + res.message + '</div>');
                        } else {
                            $("#modalMessage").html('<div class="alert alert-danger">' + res.message + '</div>');
                        }
                    },
                    error: function () {
                        $("#modalMessage").html('<div class="alert alert-danger">حدث خطأ أثناء الاتصال بالخادم</div>');
                    },
                    complete: function () {
                        isSubmitting = false; // إعادة السماح بالإرسال بعد انتهاء العملية
                    }
                });
            });
        }
    }

    // استدعاء الفورم بعد تحميل المودال
    $(document).ready(function() {
        bindWorkOfferForm();
    });
</script>






    <script>
        function showFormDialogUniversal(button) {
            const controllerName = button.dataset.controller;
            const actionName = button.dataset.action;
            const id = button.dataset.id || null;

            let url = id ? `/${controllerName}/${actionName}/${id}` : `/${controllerName}/${actionName}`;

                   $.ajax({
            url: url,
            type: 'GET',
            success: function (result) {
                $('#editPartialContainer').html(result);
                $('#editModal').modal('show');
            },
            error: function (xhr, status, error) {
                console.error("فشل تحميل البارتشل:", xhr.responseText, error);
                alert("حدث خطأ أثناء تحميل النموذج. تحقق من Console لرؤية التفاصيل.");
            }
        });

        }
