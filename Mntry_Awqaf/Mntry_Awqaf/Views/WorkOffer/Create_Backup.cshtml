                                <input type="number" class="form-control text-end"
                                       name="${modelName}[${index}].AllowanceFees"  />
                            </div>
                        </td>
                    `;

                case 'AdditionalCosts':
                    return `
                        <td>
                            <input type="text" class="form-control" name="${modelName}[${index}].CostType"
                                   placeholder="أدخل نوع التكلفة" />
                        </td>
                        <td>
                            <input type="checkbox" class="form-check-input" name="${modelName}[${index}].IsSelected" />
                        </td>
                        <td>
                            <div class="currency-input">
                                <input type="number" class="form-control text-end"
                                       name="${modelName}[${index}].Price"  />
                            </div>
                        </td>
                    `;

                default:
                    return '';
            }
        }

        // دالة حذف صف من الجدول
        function removeRow(button, tableId) {
            const row = button.closest('tr');
            if (document.getElementById(tableId).rows.length > 1) {
                row.remove();
                renumberRows(tableId);
            } else {
                alert('يجب أن يحتوي الجدول على صف واحد على الأقل');
            }
        }

        // إعادة ترقيم الصفوف بعد الحذف
        function renumberRows(tableId) {
            const tableBody = document.getElementById(tableId);
            const rows = tableBody.getElementsByTagName('tr');

            for (let i = 0; i < rows.length; i++) {
                // تحديث رقم الصف
                rows[i].cells[0].textContent = i + 1;

                // تحديث أسماء الحقول بالفهرس الجديد
                updateFieldNames(rows[i], i);
            }
        }

        // تحديث أسماء الحقول بالفهرس الجديد
        function updateFieldNames(row, newIndex) {
            const inputs = row.querySelectorAll('input, select, textarea');

            inputs.forEach(input => {
                const name = input.getAttribute('name');
                if (name) {
                    // استخراج اسم الخاصية من الاسم الحالي (مثل "Types[0].TypeName")
                    const match = name.match(/^([^\[]+)\[\d+\](.+)$/);
                    if (match) {
                        // إنشاء الاسم الجديد مع الفهرس المحدث
                        input.name = `${match[1]}[${newIndex}]${match[2]}`;
                    }
                }
            });
        }

