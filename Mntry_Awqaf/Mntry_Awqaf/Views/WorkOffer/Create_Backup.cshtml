                                        targetDiv.innerHTML = html;
                                        updateHiddenFields(targetDiv, ".type-status-1", type1Value);
                                        updateHiddenFields(targetDiv, ".type-status-2", type2Value);
                                    })
                                    .catch(err => targetDiv.innerHTML = '<p>حدث خطأ أثناء تحميل الصفحة.</p>');
                            }
                            else if(value === "5") {
