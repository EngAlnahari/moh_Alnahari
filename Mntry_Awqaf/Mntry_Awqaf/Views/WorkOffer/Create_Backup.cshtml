<!-- أقالب التنقلات والمبيت -->
<script>
    document.addEventListener("submit", function (e) {
        if (e.target && e.target.id === "createTransportForm") { // معرف الفورم
            e.preventDefault();

            var form = e.target;
            var formData = new FormData(form);

            fetch(form.action, {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                var msgDiv = form.querySelector("#formMessages");

                if (data.success) {
                    msgDiv.innerHTML = `<div class="alert alert-success">${data.message}</div>`;

                    // بعد 3 ثواني: نخفي الرسالة ونغلق المودال
                    setTimeout(() => {
                        msgDiv.innerHTML = "";

                        var modalInstance = bootstrap.Modal.getInstance(
                            document.getElementById('transportTemplateModal1')
                        );
                        if (modalInstance) modalInstance.hide();

                    }, 3000);

                } else {
                    msgDiv.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;

                    // بعد 3 ثواني نخفي الرسالة فقط
                    setTimeout(() => {
                        msgDiv.innerHTML = "";
                    }, 3000);
                }
            })
            .catch(err => {
                var msgDiv = form.querySelector("#formMessages");
                msgDiv.innerHTML =
                    `<div class="alert alert-danger">⚠️ خطأ بالشبكة: ${err.message}</div>`;

                setTimeout(() => {
                    msgDiv.innerHTML = "";
                }, 3000);
            });
        }
    });
</script>


<script>
    // دالة لتعيين قيمة لجميع الحقول المخفية من نوع محدد داخل حاوية محددة
    function updateHiddenFields(container, className, value) {
        container.querySelectorAll(className).forEach(function(input) {
            if(input) input.value = value;
        });
    }

    function initSelectListeners() {
        var extraSelect1 = document.getElementById("extraChargesSelect1");
        var extraSelect2 = document.getElementById("extraChargesSelect2");

        // عند اختيار أي خيار من القائمة الأولى
        if(extraSelect1) {
            extraSelect1.addEventListener("change", function() {
                var container = document.getElementById("additionalContent1"); // الجدول الأول فقط
                updateHiddenFields(container, ".type-status-1", "2"); // تعيين القيمة للحقل الأول
                updateHiddenFields(container, ".type-status-2", "");  // تعيين الحقل الثاني فارغ
            });

            // تعيين القيم المبدئية عند التحميل
            if(extraSelect1.value) {
                var container = document.getElementById("additionalContent1");
                updateHiddenFields(container, ".type-status-1", "2");
                updateHiddenFields(container, ".type-status-2", "");
            }
        }

        // عند اختيار أي خيار من القائمة الثانية
        if(extraSelect2) {
            extraSelect2.addEventListener("change", function() {
                var container = document.getElementById("additionalContent2"); // الجدول الثاني فقط
                updateHiddenFields(container, ".type-status-2", "3"); // تعيين القيمة للحقل الثاني
                updateHiddenFields(container, ".type-status-1", "");  // تعيين الحقل الأول فارغ
            });

            // تعيين القيم المبدئية عند التحميل
            if(extraSelect2.value) {
                var container = document.getElementById("additionalContent2");
                updateHiddenFields(container, ".type-status-2", "3");
                updateHiddenFields(container, ".type-status-1", "");
            }
        }
    }

    // تهيئة عند تحميل الصفحة
    document.addEventListener("DOMContentLoaded", function() {
        initSelectListeners();
    });

    // --- الجزء الخاص بالمودال والقوائم الديناميكية ---
