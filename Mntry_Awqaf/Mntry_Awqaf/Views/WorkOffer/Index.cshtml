    <div class="tab-pane" id="to_me" role="tabpanel" aria-labelledby="request-tab">
        <div class="card">
            @{
                var dynamicValues = ViewBag.DynamicValues as IEnumerable<Mntry_Awqaf.Models.DynamicFieldValue>;
            }
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>رقم العرض</th>
                                @if (ViewBag.DynamicFields != null)
                                {
                                    foreach (var field in ViewBag.DynamicFields)
                                    {
                                        <th>@field.Name</th>
                                    }
                                }
                                <th>العمليات</th>
                            </tr>
                        </thead>
                        <tbody>
                             @if (Model != null && Model.Any())
 {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    @if (ViewBag.DynamicFields != null)
                                    {
                                        foreach (var field in ViewBag.DynamicFields)
                                        {
                                            int fId = (int)field.Id;
                                            var val = dynamicValues?.FirstOrDefault(v => v.RecordId == item.Id && v.DynamicFieldId == fId)?.Value ?? "-";
                                            string fieldType = (string)field.Type;

                                            if (fieldType == "file" && val != "-" && val != "")
                                            {
                                                string ext = System.IO.Path.GetExtension(val).ToLower();
                                                bool isImage = ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".bmp" || ext == ".webp" || ext == ".svg";

                                                if (isImage)
                                                {
                                                    <td>
                                                        <a href="@val" target="_blank" title="عرض الصورة">
                                                            <img src="@val" alt="مرفق" style="width:55px;height:55px;object-fit:cover;border-radius:5px;border:1px solid #ccc;" 
                                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='inline'" />
                                                            <span style="display:none">🖼️ <small>@System.IO.Path.GetFileName(val)</small></span>
                                                        </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        <a href="@val" target="_blank" title="فتح المرفق" style="text-decoration:none; color:#0d6efd;">
                                                            📎 <small>@System.IO.Path.GetFileName(val)</small>
                                                        </a>
                                                    </td>
                                                }
                                            }
                                            else
                                            {
                                                <td>@val</td>
                                            }
                                        }
                                    }
                                    <td>
                                         @{
                                             var contractsDict = ViewBag.Contracts as Dictionary<int, int> ?? new Dictionary<int, int>();
                                             if (contractsDict.TryGetValue(item.Id, out var contractId))
                                             {
                                                 <a href="#" class="view-contract-btn" data-contract-id="@contractId">
                                                     <i class="feather icon-eye f-w-600 f-16 m-r-15 text-primary"> عرض العقد</i>
                                                 </a>
                                             }
                                             else
                                             {
                                                 <span class="text-muted">لا يوجد عقد</span>
                                             }
                                         }
                                         <a asp-controller="WorkOffer" asp-action="Edit" asp-route-id="@item.Id"><i class="icon feather icon-edit f-w-600 f-16 m-r-15 text-success"></i></a>
                                         <a href="#" title="حذف" onclick="confirmDelete(@item.Id); return false;">
                                             <i class="feather icon-trash-2 f-w-600 f-16 text-danger"></i>
                                         </a>
                                    </td>
                                </tr>
                                    
                            }

                            }
                            else
                            {
                                <tr>
                                    <td colspan="17" class="text-muted">لا توجد بيانات متاحة حاليًا</td>
                                </tr>
                            }
                                        </tbody>
                                    </table>
                    
                                </div>
                            </div>
                        </div>
                    </div>


    @Html.Partial("~/Views/Service/show.cshtml")
